<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TargetFramework / Nullable / ImplicitUsings are managed centrally by Directory.Build.props -->
    <RootNamespace>COD.FirmwideDirectory.PhotoImportTool</RootNamespace>
    <AssemblyName>COD.FirmwideDirectory.PhotoImportTool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse Core Utility / XmlHelper / Models / Faults as the single source of definitions -->
    <ProjectReference Include="..\COD.FirmwideDirectory.API\COD.FirmwideDirectory.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Extract photo ZIP files; keep the package version aligned with Core/API -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
