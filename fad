$upgradeNodeText = Invoke-UpgradeChecked 'node' @('-p', 'process.versions.node')
$upgradeNodeVersion = [version]($upgradeNodeText | Select-Object -Last 1)
if ($upgradeNodeVersion.Major -eq 22 -and $upgradeNodeVersion -ge [version]'22.12.0') {
    $UpgradeRuntimeMode = 'SupportedBridge'
} elseif ($upgradeNodeVersion.Major -eq 24) {
    $UpgradeRuntimeMode = 'Node24Transition'
    Write-Warning 'Angular 19 baseline on Node 24 is outside its official compatibility matrix. Preserve this deviation and all failures.'
} else {
    throw 'No documented runtime route: use an enterprise-approved Node 22 >=22.12 or Node 24, or a verified build environment.'
}
Write-Host "Runtime route: $UpgradeRuntimeMode; Node: $upgradeNodeVersion"
```

将 runtimeMode、Node/npm 精确版本、项目根目录、基线源码/lock 哈希、限制原因和基线结果写入本批次升级记录（建议 `.tmp/upgrade/<run-id>/runtime.json`），跨进程调用必须重新加载，不能只依赖内存变量。每次关键安装前与记录对照，不静默切换 Node。
