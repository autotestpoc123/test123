(() => {
  // 改成需要比较的照片文件名
  const target = '00MYH.jpg'.toLowerCase();

  const figures = [...document.querySelectorAll('main > figure')];

  const matches = figures.filter(figure => {
    const source = figure.querySelector('figcaption')
      ?.firstChild?.textContent?.trim()
      .replaceAll('\\', '/')
      .toLowerCase();

    return source?.split('/').pop() === target;
  });

  if (!matches.length) {
    console.warn('没有找到这张照片，请核对文件名。');
    return;
  }

  figures.forEach(figure => {
    figure.hidden = !matches.includes(figure);
  });

  console.log(`当前显示 ${matches.length} 个版本。`);
})();


档位	截图中的观感	文件大小
126px/q75	面部较平滑，镜框可以辨认，但头发和眼部细节偏软	3,938 bytes
256px/q75	镜框、眼睛和发际线较清楚，整体比较自然	14,977 bytes
512px/q75	头发、皮肤的颗粒感更明显，未看出相对 256px 有明显的整体观感提升	41,665 bytes


256px 比 512px 少约 64% 的文件体积，而这组截图里没有表现出同等明显的画质损失。因此：
- Profile 的 126×126 CSS px 头像：优先验证 256px。
- 点击放大的弹窗：保留 512px。
- 126px 可以作为更节省流量的选择，但这张样本中细节保留不如 256px。
512px 看起来颗粒更多，不能仅凭截图确定是原图噪点、锐化还是预览缩放造成的，也不代表它的真实细节更少。
