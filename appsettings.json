    "PhotoZipPath": "\\\\nas\\share\\photos\\global-photos.zip",
    "UsersZipPath": "\\\\nas\\share\\users\\users.zip",
    "UsersDsmlName": "users.dsml",

    "//XmlPhotoPath": "空/缺省 = 不启用 XML 源(纯 zip);配单个 CrossFire 大文件路径即启用",
